//@version=6
// CrucibleEdge conformance: runs every CrucibleEdge function on fixed trade logs and compares
// the results with the values crucible's own edge_report produced for the same logs
// (pine/gen_vectors.py in the crucible repo). Add to any chart; the table is the result.
// PASS/FAIL here is a unit test of arithmetic, not a verdict on any strategy.
indicator("CrucibleEdge conformance", overlay = false)
import BlueMagicTrading/CrucibleEdge/9 as ce
// Table colours follow the chart theme (chart.bg_color / chart.fg_color) via the library's style.
st = ce.styleAuto("small")

TOL = 1e-6

// expected values: "inf" -> the IsInf predicate must be true and the value na; "nan" -> na
type Case
    string name
    ce.TradeLog tlog
    int n
    float winRate
    float expectancy
    string profitFactor
    string payoffRatio
    float sqn
    string excursionRatio
    string timeAsymmetry
    string exitEfficiency
    float maxDrawdownR

mk(string name, array<float> r, array<float> mfe, array<float> mae, array<float> bars, int n, float wr, float e, string pf, string po,
     float sq, string ex, string ta, string ee, float dd) =>
    tlog = ce.newLog()
    for i = 0 to array.size(r) - 1
        ce.append(tlog, array.get(r, i), na(mfe) ? na : array.get(mfe, i), na(mae) ? na : array.get(mae, i), na(bars) ? na : array.get(bars, i))
    Case.new(name, tlog, n, wr, e, pf, po, sq, ex, ta, ee, dd)

var cases = array.new<Case>()
if barstate.isfirst
    array.push(cases, mk("mixed",
         array.from(2.5, -1.0, 0.8, -1.0, 4.2, -0.6, 0.0, 1.1, -1.0, 3.0, -0.4, 0.5),
         array.from(3.1, 0.4, 1.2, 0.2, 5.0, 0.9, 0.7, 1.5, 0.1, 3.6, 0.3, 1.0),
         array.from(-0.3, -1.0, -0.5, -1.0, -0.2, -1.0, -0.4, -0.6, -1.0, -0.1, -1.0, -0.8),
         array.from(12.0, 3, 7, 2, 30, 4, 5, 9, 1, 25, 3, 6),
         12, 0.5, 0.675, "3.025", "2.5208333333", 1.3491315206, "2.2784810127", "5.7051282051", "0.7857142857", 1.2))
    array.push(cases, mk("no_losers", array.from(1.0, 2.0, 0.5), array.from(1.2, 2.4, 0.9), array.from(-0.2, -0.1, -0.3), array.from(4.0, 8, 2),
         3, 1.0, 1.1666666667, "inf", "inf", 2.6457513111, "7.5", "nan", "0.7777777778", 0.0))
    array.push(cases, mk("all_losers", array.from(-1.0, -0.5, -1.0), array.from(0.2, 0.4, 0.0), array.from(-1.0, -0.8, -1.0), array.from(2.0, 5, 1),
         3, 0.0, -0.8333333333, "0", "0", -5.0, "0.2142857143", "nan", "nan", 1.5))
    array.push(cases, mk("identical", array.from(0.7, 0.7, 0.7, 0.7), array.from(1.0, 1.0, 1.0, 1.0), array.from(-0.2, -0.2, -0.2, -0.2), array.from(3.0, 3, 3, 3),
         4, 1.0, 0.7, "inf", "inf", 0.0, "5", "nan", "0.7", 0.0))
    array.push(cases, mk("single", array.from(1.5), array.from(2.0), array.from(-0.4), array.from(6.0),
         1, 1.0, 1.5, "inf", "inf", 0.0, "5", "nan", "0.75", 0.0))
    // n150: r_i = ((i*7919) mod 13 - 5) / 4, no optional columns; exercises the sqn cap at 100
    r150 = array.new<float>()
    for i = 0 to 149
        array.push(r150, ((i * 7919) % 13 - 5) / 4.0)
    array.push(cases, mk("n150", r150, na, na, na, 150, 0.54, 0.25, "1.8620689655", "1.3333333333", 2.6548540004, "nan", "nan", "nan", 2.25))

near(float got, float want) => not na(got) and math.abs(got - want) <= TOL
// string-expected metrics: "inf" -> na value and predicate true; "nan" -> na; else numeric
chk(float got, bool isInf, string want) =>
    want == "inf" ? (na(got) and isInf) : want == "nan" ? na(got) : near(got, str.tonumber(want))
cell(table t, int c, int r, string txt, bool ok) =>
    table.cell(t, c, r, txt, text_color = st.fg, bgcolor = ok ? st.pass : st.fail, text_size = size.small, text_formatting = ce.textFormat(st))
hdr(table t, int c, string txt) =>
    table.cell(t, c, 0, txt, text_color = st.fg, bgcolor = st.keyBg, text_size = size.small, text_formatting = ce.textFormat(st))

var tbl = table.new(position.middle_center, 11, 8, border_width = 1)
if barstate.islast
    names = array.from("case", "n", "win rate", "expectancy", "PF", "payoff", "SQN-100", "excursion", "time asym", "exit eff", "max DD R")
    for c = 0 to 10
        hdr(tbl, c, array.get(names, c))
    allOk = true
    for k = 0 to array.size(cases) - 1
        cs = array.get(cases, k)
        rep = ce.edgeReport(cs.tlog)
        row = k + 1
        oks = array.from(rep.n == cs.n, near(rep.winRate, cs.winRate), near(rep.expectancy, cs.expectancy),
             chk(rep.profitFactor, rep.profitFactorInf, cs.profitFactor), chk(rep.payoffRatio, rep.payoffRatioInf, cs.payoffRatio),
             near(rep.sqn, cs.sqn), chk(rep.excursionRatio, false, cs.excursionRatio), chk(rep.timeAsymmetry, false, cs.timeAsymmetry),
             chk(rep.exitEfficiency, false, cs.exitEfficiency), near(rep.maxDrawdownR, cs.maxDrawdownR))
        vals = array.from(str.tostring(rep.n), str.tostring(rep.winRate, "#.####"), str.tostring(rep.expectancy, "#.####"),
             rep.profitFactorInf ? "inf" : str.tostring(rep.profitFactor, "#.####"), rep.payoffRatioInf ? "inf" : str.tostring(rep.payoffRatio, "#.####"),
             str.tostring(rep.sqn, "#.####"), str.tostring(rep.excursionRatio, "#.####"), str.tostring(rep.timeAsymmetry, "#.####"),
             str.tostring(rep.exitEfficiency, "#.####"), str.tostring(rep.maxDrawdownR, "#.####"))
        rowOk = true
        for j in oks
            rowOk := rowOk and j
        allOk := allOk and rowOk
        cell(tbl, 0, row, cs.name, rowOk)
        for c = 0 to 9
            cell(tbl, c + 1, row, array.get(vals, c), array.get(oks, c))
    table.cell(tbl, 0, 7, allOk ? "ALL PASS vs crucible 0.7.0" : "FAIL: see red cells", text_color = st.fg,
         bgcolor = allOk ? st.pass : st.fail, text_size = size.normal)
